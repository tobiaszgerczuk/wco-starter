{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/section-heading",
  "title": "Section Heading",
  "description": "Eyebrow, heading and lead text. Edit directly in the preview.",
  "category": "wco-blocks",
  "icon": "heading",
  "keywords": [
    "heading",
    "title",
    "section"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Section Heading",
    "controls": [
      {
        "attr": "section_heading_align",
        "label": "Wyrównanie",
        "type": "select",
        "options": {
          "left": "Po lewej",
          "center": "Środek",
          "right": "Po prawej"
        }
      }
    ],
    "frame": {
      "inner": "block-section-heading__inner block-section-heading__inner--{section_heading_align:center}"
    }
  },
  "attributes": {
    "section_heading_align": {
      "type": "string",
      "default": "center"
    }
  }
}

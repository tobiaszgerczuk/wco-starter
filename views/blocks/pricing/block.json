{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/pricing",
  "title": "Pricing",
  "description": "Pricing plans. Add, reorder and edit plans in the preview.",
  "category": "wco-blocks",
  "icon": "money-alt",
  "keywords": [
    "pricing",
    "plans",
    "packages"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Pricing",
    "controls": [
      {
        "attr": "pricing_columns",
        "label": "Kolumny",
        "type": "select",
        "options": {
          "2": "2 kolumny",
          "3": "3 kolumny",
          "4": "4 kolumny"
        }
      }
    ],
    "frame": {
      "inner": "block-pricing__items block-pricing__items--cols-{pricing_columns:3}"
    }
  },
  "attributes": {
    "pricing_columns": {
      "type": "string",
      "default": "3"
    }
  }
}

<section{% if section_id %} id="{{ section_id }}"{% endif %} class="{{ section_classes }}"{% if section_style %} style="{{ section_style }}"{% endif %}>
  <div{% if container_class %} class="{{ container_class }}"{% endif %}>
    <div class="block-text-image__inner block-text-image__inner--image-{{ fields.text_image_image_position|default('right') }} block-text-image__inner--size-{{ fields.text_image_image_size|default('half') }} block-text-image__inner--align-{{ fields.text_image_vertical_align|default('center') }}{{ fields.text_image_reverse_mobile ? ' block-text-image__inner--image-first-mobile' : '' }}">
      {{ inner_blocks(inner_template) }}
    </div>
  </div>
</section>

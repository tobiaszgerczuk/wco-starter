{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/timeline",
  "title": "Timeline",
  "description": "Milestones on a vertical line. Add, reorder and edit steps in the preview.",
  "category": "wco-blocks",
  "icon": "backup",
  "keywords": [
    "timeline",
    "history",
    "steps"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Timeline",
    "controls": [
      {
        "attr": "timeline_layout",
        "label": "Układ",
        "type": "select",
        "options": {
          "line": "Po jednej stronie",
          "alternate": "Naprzemiennie"
        }
      }
    ],
    "frame": {
      "inner": "block-timeline__items block-timeline__items--{timeline_layout:line}"
    }
  },
  "attributes": {
    "timeline_layout": {
      "type": "string",
      "default": "line"
    }
  }
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/timeline",
  "title": "Timeline",
  "description": "Milestones on a vertical line. Add, reorder and edit steps in the preview.",
  "category": "wco-blocks",
  "icon": "backup",
  "keywords": [
    "timeline",
    "history",
    "steps"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "timeline.include.php"
  },
  "supports": {
    "jsx": true,
    "anchor": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true
  }
}

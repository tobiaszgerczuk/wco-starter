{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/faq",
  "title": "FAQ",
  "description": "Accordion of questions. Edit questions and answers in the preview.",
  "category": "wco-blocks",
  "icon": "editor-help",
  "keywords": [
    "faq",
    "accordion",
    "questions"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: FAQ",
    "controls": [
      {
        "attr": "faq_open_first",
        "label": "Otwórz pierwsze pytanie",
        "type": "toggle"
      },
      {
        "attr": "faq_allow_multiple",
        "label": "Pozwól otwierać kilka naraz",
        "type": "toggle"
      },
      {
        "attr": "faq_schema",
        "label": "Dane strukturalne FAQ (SEO)",
        "type": "toggle"
      }
    ],
    "frame": {
      "inner": "block-faq__list"
    }
  },
  "attributes": {
    "faq_open_first": {
      "type": "boolean",
      "default": false
    },
    "faq_allow_multiple": {
      "type": "boolean",
      "default": false
    },
    "faq_schema": {
      "type": "boolean",
      "default": true
    }
  }
}

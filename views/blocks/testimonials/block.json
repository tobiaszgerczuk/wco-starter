{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/testimonials",
  "title": "Testimonials",
  "description": "Customer quotes. Add, reorder and edit quotes in the preview.",
  "category": "wco-blocks",
  "icon": "format-quote",
  "keywords": [
    "testimonials",
    "reviews",
    "quotes"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Opinie",
    "controls": [
      {
        "attr": "testimonials_columns",
        "label": "Kolumny",
        "type": "select",
        "options": {
          "1": "1 kolumna",
          "2": "2 kolumny",
          "3": "3 kolumny"
        }
      }
    ],
    "frame": {
      "inner": "block-testimonials__items block-testimonials__items--cols-{testimonials_columns:3}"
    }
  },
  "attributes": {
    "testimonials_columns": {
      "type": "string",
      "default": "3"
    }
  }
}

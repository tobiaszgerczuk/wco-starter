{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/hero",
  "title": "Hero",
  "description": "Hero with text and image, optional background image. Edit text and image in the preview.",
  "category": "wco-blocks",
  "icon": "cover-image",
  "keywords": [
    "hero",
    "banner",
    "header"
  ],
  "supports": {
    "anchor": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "native": true,
    "sectionSettings": true,
    "panel": "Ustawienia hero",
    "controls": [
      {
        "attr": "hero_min_height",
        "type": "select",
        "label": "Minimalna wysokość",
        "options": {
          "auto": "Auto",
          "md": "Średnia",
          "lg": "Duża",
          "screen": "Pełny ekran"
        }
      },
      {
        "attr": "hero_image_position",
        "type": "select",
        "label": "Pozycja obrazu",
        "options": {
          "right": "Po prawej",
          "left": "Po lewej"
        }
      },
      {
        "attr": "hero_background_image",
        "type": "image",
        "label": "Obraz tła"
      },
      {
        "attr": "hero_overlay",
        "type": "range",
        "label": "Przyciemnienie (%)",
        "min": 0,
        "max": 90,
        "showWhen": "hero_background_image"
      }
    ]
  },
  "attributes": {
    "hero_min_height": {
      "type": "string",
      "default": "auto"
    },
    "hero_image_position": {
      "type": "string",
      "default": "right"
    },
    "hero_background_image": {
      "type": "number"
    },
    "hero_overlay": {
      "type": "number",
      "default": 40
    }
  }
}

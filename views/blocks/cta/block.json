{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/cta",
  "title": "Call to Action",
  "description": "Heading, text and buttons. Edit directly in the preview.",
  "category": "wco-blocks",
  "icon": "megaphone",
  "keywords": [
    "cta",
    "action",
    "banner"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Call to Action",
    "controls": [
      {
        "attr": "cta_align",
        "label": "Wyrównanie",
        "type": "select",
        "options": {
          "center": "Środek",
          "left": "Po lewej"
        }
      },
      {
        "attr": "cta_boxed",
        "label": "Pokaż w zaokrąglonym pudełku",
        "type": "toggle"
      }
    ],
    "frame": {
      "inner": "block-cta__inner block-cta__inner--{cta_align:center}{cta_boxed? block-cta__inner--boxed}"
    }
  },
  "attributes": {
    "cta_align": {
      "type": "string",
      "default": "center"
    },
    "cta_boxed": {
      "type": "boolean",
      "default": false
    }
  }
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/map",
  "title": "Map",
  "description": "Embedded map that loads after a click (privacy friendly).",
  "category": "wco-blocks",
  "icon": "location-alt",
  "keywords": [
    "map",
    "location",
    "google maps"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Map",
    "controls": [
      {
        "attr": "map_address",
        "label": "Adres",
        "type": "text"
      },
      {
        "attr": "map_embed_url",
        "label": "Własny adres osadzenia (opcjonalnie)",
        "type": "text"
      },
      {
        "attr": "map_height",
        "label": "Wysokość mapy (px)",
        "type": "select",
        "options": {
          "300": "300",
          "400": "400",
          "500": "500",
          "600": "600"
        }
      }
    ],
    "frame": {
      "head": "block-map__head",
      "after": {
        "class": "block-map__frame",
        "text": "Mapa wczyta się na stronie po kliknięciu."
      }
    }
  },
  "attributes": {
    "map_address": {
      "type": "string",
      "default": ""
    },
    "map_embed_url": {
      "type": "string",
      "default": ""
    },
    "map_height": {
      "type": "string",
      "default": "400"
    }
  }
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/video",
  "title": "Video",
  "description": "YouTube, Vimeo or a video file. The player loads after a click (privacy friendly).",
  "category": "wco-blocks",
  "icon": "video-alt3",
  "keywords": [
    "video",
    "youtube",
    "vimeo"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Video",
    "controls": [
      {
        "attr": "video_url",
        "label": "Adres wideo",
        "type": "text"
      },
      {
        "attr": "video_poster",
        "label": "Obraz okładki",
        "type": "image"
      },
      {
        "attr": "video_ratio",
        "label": "Proporcje",
        "type": "select",
        "options": {
          "16-9": "16:9",
          "4-3": "4:3",
          "1-1": "1:1"
        }
      }
    ],
    "frame": {
      "head": "block-video__head",
      "after": {
        "class": "block-video__player block-video__player--{video_ratio:16-9}",
        "text": "Odtwarzacz wideo pojawi się na stronie."
      }
    }
  },
  "attributes": {
    "video_url": {
      "type": "string",
      "default": ""
    },
    "video_poster": {
      "type": "number"
    },
    "video_ratio": {
      "type": "string",
      "default": "16-9"
    }
  }
}

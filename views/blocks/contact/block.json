{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/contact",
  "title": "Contact",
  "description": "Contact details next to a form (Contact Form 7 or another form shortcode).",
  "category": "wco-blocks",
  "icon": "email-alt",
  "keywords": [
    "contact",
    "form",
    "cf7"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Contact",
    "controls": [
      {
        "attr": "contact_form_shortcode",
        "label": "Shortcode formularza",
        "type": "text"
      },
      {
        "attr": "contact_form_position",
        "label": "Pozycja formularza",
        "type": "select",
        "options": {
          "right": "Po prawej",
          "left": "Po lewej"
        }
      }
    ],
    "frame": {
      "inner": "block-contact__inner block-contact__inner--form-{contact_form_position:right}",
      "head": "block-contact__info",
      "after": {
        "class": "block-contact__form",
        "text": "Formularz (shortcode) pojawi się na stronie."
      }
    }
  },
  "attributes": {
    "contact_form_shortcode": {
      "type": "string",
      "default": ""
    },
    "contact_form_position": {
      "type": "string",
      "default": "right"
    }
  }
}

{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/gallery",
  "title": "Gallery",
  "description": "Image grid. Add images in the preview.",
  "category": "wco-blocks",
  "icon": "format-gallery",
  "keywords": [
    "gallery",
    "images",
    "photos"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "gallery.include.php"
  },
  "supports": {
    "jsx": true,
    "anchor": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true
  }
}

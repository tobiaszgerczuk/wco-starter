{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/stats",
  "title": "Stats",
  "description": "Row of numbers with labels. Edit numbers and labels in the preview.",
  "category": "wco-blocks",
  "icon": "chart-bar",
  "keywords": [
    "stats",
    "numbers",
    "counters"
  ],
  "supports": {
    "align": [
      "full",
      "wide"
    ]
  },
  "wco": {
    "sectionSettings": true,
    "native": true,
    "panel": "Ustawienia: Stats",
    "controls": [
      {
        "attr": "stats_columns",
        "label": "Kolumny",
        "type": "select",
        "options": {
          "2": "2 kolumny",
          "3": "3 kolumny",
          "4": "4 kolumny"
        }
      }
    ],
    "frame": {
      "inner": "block-stats__items block-stats__items--cols-{stats_columns:4}"
    }
  },
  "attributes": {
    "stats_columns": {
      "type": "string",
      "default": "4"
    }
  }
}
